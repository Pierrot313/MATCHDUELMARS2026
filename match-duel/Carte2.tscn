[sub_resource type="Shader" id="Shader_10nlt"]
code = "shader_type canvas_item;

void fragment() {
    vec2 uv = UV;
    vec2 pixel = uv * vec2(167.3, 168.5);
    float radius = 8.0;

    vec2 corner = clamp(pixel, vec2(radius), vec2(130.0 - radius, 160.0 - radius));
    float dist = length(pixel - corner);

    if (dist > radius) discard;

    COLOR = texture(TEXTURE, uv);
}"

